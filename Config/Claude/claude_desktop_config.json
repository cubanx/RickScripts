{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {
        "SERENA_INCLUDED_OPTIONAL_TOOLS": "initial_instructions"
      }
    },
    "GitLab": {
      "command": "/opt/homebrew/bin/gitlab-mcp"
    }
  }
}
